@{
    ViewData["Title"] = "Contato";
}

<div class="container py-4">
    <h1 class="mb-4">Entre em Contato</h1>
    <p class="text-muted mb-4">Tens alguma questão ou proposta? Podes enviar-me uma mensagem através do formulário abaixo.</p>

    <div class="row">
        <div class="col-md-6 mb-4">
            <form>
                <div class="mb-3">
                    <label for="nome" class="form-label">Nome</label>
                    <input type="text" class="form-control" id="nome" placeholder="O teu nome">
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">E-mail</label>
                    <input type="email" class="form-control" id="email" placeholder="nome@exemplo.com">
                </div>
                <div class="mb-3">
                    <label for="mensagem" class="form-label">Mensagem</label>
                    <textarea class="form-control" id="mensagem" rows="4" placeholder="Escreve a tua mensagem aqui..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Enviar Mensagem</button>
            </form>
        </div>
        <div class="col-md-6">
            <div class="card p-4 shadow-sm bg-light">
                <h3>Informações Diretas</h3>
                <p class="mt-3 mb-2"><strong>Email:</strong> exemplo@email.com</p>
                <p class="mb-2"><strong>Localização:</strong> Portugal</p>
            </div>
        </div>
    </div>
</div>